---
import ArrowUpRight from '@phosphor-icons/core/assets/regular/arrow-up-right.svg';
import ArrowUp from '@phosphor-icons/core/assets/regular/arrow-up.svg';
import GithubLogo from '@phosphor-icons/core/assets/regular/github-logo.svg';
import LinkedinLogo from '@phosphor-icons/core/assets/regular/linkedin-logo.svg';
import XLogo from '@phosphor-icons/core/assets/regular/x-logo.svg';
import PencilLine from '@phosphor-icons/core/assets/regular/pencil-line.svg';
import CookingPot from '@phosphor-icons/core/assets/regular/cooking-pot.svg';
import Robot from '@phosphor-icons/core/assets/regular/robot.svg';
import FlagCheckered from '@phosphor-icons/core/assets/regular/flag-checkered.svg';
import CaretDown from '@phosphor-icons/core/assets/regular/caret-down.svg';

const icons = { ArrowUpRight, ArrowUp, GithubLogo, LinkedinLogo, XLogo, PencilLine, CookingPot, Robot, FlagCheckered, CaretDown };
const { name, size = 20, class: className = '' } = Astro.props;
const Graphic = icons[name];
---
<span class:list={['phosphor-icon', className]} aria-hidden="true"><Graphic width={size} height={size} /></span>

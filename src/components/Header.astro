---
import Icon from './Icon.astro';

const { current = 'home' } = Astro.props;
const links = [
  { label: 'Home', href: '/', key: 'home' },
  { label: 'Work', href: '/work/', key: 'work' },
  { label: 'Blog', href: '/blog/', key: 'blog' },
  { label: 'Shop', href: '/shop/', key: 'shop' },
  { label: 'Contact', href: '/#contact', key: 'contact' }
];
---
<header class="header" aria-label="Main navigation">
  <a class="brand" href="/" aria-label="Jennie Muso, home">JM<span class="brand-dot">.</span></a>
  <nav class="desktop-nav" aria-label="Primary">
    {links.map(({ label, href, key }) => <a href={href} class={current === key ? 'active' : undefined} aria-current={current === key ? 'page' : undefined}>{label}</a>)}
  </nav>
  <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav"><span class="menu-toggle-lines" aria-hidden="true"><span></span><span></span></span></button>
</header>
<nav class="mobile-nav" id="mobile-nav" aria-label="Mobile" hidden>
  <div class="mobile-nav-panel">
    <div class="mobile-nav-links">
      {links.map(({ label, href, key }) => <a href={href} aria-current={current === key ? 'page' : undefined}>{label}</a>)}
    </div>
    <a class="mobile-work-link" href="/#contact">Work with me <Icon name="ArrowUpRight" size={18} /></a>
    <div class="mobile-socials">
      <p>Keep in touch on socials</p>
      <div class="mobile-social-links">
        <a href="https://x.com/TracyCss" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)"><Icon name="XLogo" size={20} /></a>
        <a href="https://github.com/muchirijane" target="_blank" rel="noopener noreferrer" aria-label="GitHub"><Icon name="GithubLogo" size={20} /></a>
        <a href="https://www.linkedin.com/in/jane-muthoni-muchiri/?lipi=urn%3Ali%3Apage%3Ap_mwlite_feed%3BDQsEfHy8SQyL%2FYHMCFuT%2Bg%3D%3D" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><Icon name="LinkedinLogo" size={20} /></a>
      </div>
    </div>
  </div>
</nav>

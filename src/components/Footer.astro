---
import Icon from './Icon.astro';
const pages = [
  { label: 'Home', href: '/' },
  { label: 'Work', href: '/work/' },
  { label: 'Services', href: '/services/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'Shop', href: '/shop/' },
  { label: 'Contact', href: '/contact/' }
];
const socials = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/jane-muthoni-muchiri/' },
  { label: 'GitHub', href: 'https://github.com/muchirijane' },
  { label: 'X / Twitter', href: 'https://x.com/TracyCss' }
];
---
<footer class="footer">
  <div class="footer-top">
    <div class="footer-intro">
      <span>Muso Design Studio</span>
      <p>Good work starts<br />with a conversation.</p>
      <a href="/contact/">Tell me what you’re making <Icon name="ArrowUpRight" size={22} /></a>
    </div>
    <nav class="footer-links" aria-label="Footer navigation">
      {pages.map(({ label, href }) => <a href={href}>{label}</a>)}
    </nav>
    <nav class="footer-links footer-socials" aria-label="Social media">
      {socials.map(({ label, href }) => <a href={href} target="_blank" rel="noopener noreferrer">{label}<span class="sr-only"> (opens in a new tab)</span></a>)}
    </nav>
  </div>
  <a class="footer-wordmark" href="/" aria-label="Muso Design Studio, home">MUSO<span>.</span></a>
  <div class="footer-bottom">
    <span>© <span id="year">2026</span> Jane Muso</span>
    <span>Independent digital design &amp; development</span>
    <a href="#top">Back to top <Icon name="ArrowUp" size={18} /></a>
  </div>
</footer>

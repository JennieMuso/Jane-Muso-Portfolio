---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const { title, description, current = 'home', styles = [], bodyClass = '', image, type = 'website', schema, modified } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const socialImage = image ? new URL(image, Astro.site).href : undefined;
const structuredData = schema ? JSON.stringify(schema).replace(/</g, '\\u003c') : undefined;
const needsMotion = ['home', 'work', 'blog'].includes(current);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3f0e8" />
    <meta name="description" content={description} />
    {modified && <meta name="date-modified" content={modified} />}
    <link rel="canonical" href={canonical} />
    <link rel="ard" href="/.well-known/ard.json" type="application/json" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    {structuredData && <script type="application/ld+json" set:html={structuredData} />}
    <link rel="icon" type="image/png" href="/assets/jennie-favicon.png" />
    <link rel="preconnect" href="https://cdn.sanity.io" crossorigin />
    <link rel="preload" href="/assets/oswald-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/dm-sans-400.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    {styles.map((sheet) => <link rel="stylesheet" href={`/${sheet}`} />)}
    <link rel="stylesheet" href="/phosphor.css" />
    <link rel="stylesheet" href="/mobile-menu.css" />
    <link rel="stylesheet" href="/heading-weight.css" />
  </head>
  <body class={bodyClass}>
    <div class="site-shell" id="top">
      <Header current={current} />
      <main><slot /></main>
      <Footer />
    </div>
    {needsMotion && <script src="/assets/gsap.min.js" defer></script>}
    {needsMotion && <script src="/assets/ScrollTrigger.min.js" defer></script>}
    <script src="/script.js" defer></script>
  </body>
</html>

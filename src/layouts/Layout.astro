---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const { title, description, current = 'home', styles = [], bodyClass = '' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3f0e8" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/assets/jennie-favicon.png" />
    <title>{title}</title>
    {styles.map((sheet) => <link rel="stylesheet" href={`/${sheet}`} />)}
    <link rel="stylesheet" href="/phosphor.css" />
    <link rel="stylesheet" href="/mobile-menu.css" />
  </head>
  <body class={bodyClass}>
    <div class="site-shell" id="top">
      <Header current={current} />
      <main><slot /></main>
      <Footer />
    </div>
    <script src="/assets/gsap.min.js" defer></script>
    <script src="/assets/ScrollTrigger.min.js" defer></script>
    <script src="/script.js" defer></script>
  </body>
</html>

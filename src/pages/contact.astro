---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import { contactFaqs } from '../data/faqs';
import { servicePackages } from '../data/servicePackages';
import { contentUpdated, faqSchema, graph, personSchema, siteUrl } from '../data/seo';
const budgetBands = [
  { value: 'first', usd: 'USD 1,500–3,000', aed: 'AED 5,000–8,500' },
  { value: 'second', usd: 'USD 3,000–4,500', aed: 'AED 8,500–15,000' },
  { value: 'third', usd: 'USD 4,500–7,500', aed: 'AED 15,000–25,000' },
  { value: 'fourth', usd: 'USD 7,500+', aed: 'AED 25,000+' }
];
const schema = graph(
  personSchema,
  { '@type': 'ContactPage', '@id': `${siteUrl}/contact/#webpage`, url: `${siteUrl}/contact/`, name: 'Contact Jennie Muso', mainEntity: { '@id': `${siteUrl}/#jennie-muso` }, dateModified: contentUpdated },
  faqSchema(contactFaqs)
);
---
<Layout
  title="Contact — Jennie Muso"
  description="Tell Jennie Muso about your business and the website, app, or digital experience you want to create."
  current="contact"
  styles={['fonts.css', 'styles.css', 'editorial.css', 'projects.css', 'reference-layout.css', 'refinements.css', 'contact.css', 'faq.css', 'contact-steps.css']}
  bodyClass="contact-page"
  schema={schema}
  modified={contentUpdated}
>
  <section class="contact-hero" aria-labelledby="contact-page-title">
    <div class="contact-page-meta"><span>Jennie Muso / Founder & Designer</span><span>Open to thoughtful collaborations</span><span>Contact / Start here</span></div>
    <h1 id="contact-page-title">LET’S TALK<span>.</span><br>ABOUT IT<span>.</span></h1>
    <div class="contact-hero-stage">
      <div class="contact-hero-note">
        <p>Good work starts with a good conversation. Tell me what you’re making, what’s getting in the way, and what you want people to feel when they find you.</p>
        <a class="contact-hero-link" href="#project-brief">Tell me about your idea <Icon name="ArrowUpRight" size={20} /></a>
        <span class="contact-hero-caption">A little curiosity makes the best work.</span>
      </div>
      <figure class="contact-portrait">
        <img src="/assets/jennie-portrait-preview.jpg" alt="Jennie Muso working at her desk with a tablet" width="1086" height="1448" fetchpriority="high" />
      </figure>
    </div>
  </section>

  <section class="project-brief" id="project-brief" aria-labelledby="project-brief-title">
    <div class="project-brief-intro">
      <h2 id="project-brief-title">TELL ME<br>WHAT’S ON<br>YOUR MIND<span>.</span></h2>
      <p>Whether your idea is fully formed or still a few notes on a page, I’d love to hear it. The details below help me understand what matters most to you.</p>
      <div class="brief-direct"><span>Prefer to keep it simple?</span><a href="mailto:hello@jenniemuso.com">Email me directly <Icon name="ArrowUpRight" size={18} /></a></div>
    </div>

    <form class="project-form enquiry-form" id="project-form" action="mailto:hello@jenniemuso.com" method="post" enctype="text/plain" novalidate>
      <div class="enquiry-progress"><span>Muso website enquiry</span><span id="step-count" aria-live="polite">Step 1 of 4</span></div>
      <div class="enquiry-progress-track" role="progressbar" aria-label="Enquiry progress" aria-valuemin="1" aria-valuemax="4" aria-valuenow="1"><span data-progress-bar></span></div>
      <p class="package-referral" id="package-referral" hidden></p>

      <section class="enquiry-step" data-step="0" aria-labelledby="market-title">
        <div class="enquiry-step-heading"><span>01 / Your market</span><h3 id="market-title" tabindex="-1">Where is your business based?</h3><p>Choose the currency you’d like to discuss your project in.</p></div>
        <fieldset class="choice-group"><legend>Preferred currency <span class="required">*</span></legend><div class="choice-grid currency-grid">
          <label class="choice-option"><input type="radio" name="currency" value="AED" required /><span>AED <small>UAE</small></span></label>
          <label class="choice-option"><input type="radio" name="currency" value="USD" checked /><span>USD <small>International</small></span></label>
        </div></fieldset>
        <div class="step-actions"><button type="button" class="step-next" data-next>Next: your project <Icon name="ArrowUpRight" size={19} /></button></div>
      </section>

      <section class="enquiry-step" data-step="1" aria-labelledby="project-step-title" hidden>
        <div class="enquiry-step-heading"><span>02 / Your project</span><h3 id="project-step-title" tabindex="-1">What are we making?</h3><p>A little about what you need and which package feels right.</p></div>
        <fieldset class="choice-group"><legend>What are we working on? <span class="required">*</span></legend><div class="choice-stack">
          <label class="choice-option"><input type="radio" name="projectType" value="new" required /><span>A brand-new website</span></label>
          <label class="choice-option"><input type="radio" name="projectType" value="redesign" /><span>Redesigning an existing website</span></label>
          <label class="choice-option"><input type="radio" name="projectType" value="development" /><span>Development of an existing design</span></label>
          <label class="choice-option"><input type="radio" name="projectType" value="other" /><span>Something else</span></label>
        </div></fieldset>
        <fieldset class="choice-group"><legend>Which package feels right? <span class="required">*</span></legend><div class="choice-stack">
          {servicePackages.map((item, index) => <label class="choice-option"><input type="radio" name="package" value={item.id} required={index === 0} /><span>{item.name} <small data-price data-usd={`from USD ${item.priceUsd}`} data-aed={`from AED ${item.priceAed}`}>from USD {item.priceUsd}</small></span></label>)}
          <label class="choice-option"><input type="radio" name="package" value="unsure" /><span>Not sure yet <small>Guide me</small></span></label>
        </div><p class="choice-note">These are starting prices. <a href="/services/" target="_blank" rel="noopener noreferrer">Compare the packages <Icon name="ArrowUpRight" size={14} /></a></p></fieldset>
        <div class="step-actions"><button type="button" class="step-back" data-back><Icon name="ArrowLeft" size={18} /> Back</button><button type="button" class="step-next" data-next>Next: investment <Icon name="ArrowUpRight" size={19} /></button></div>
      </section>

      <section class="enquiry-step" data-step="2" aria-labelledby="investment-title" hidden>
        <div class="enquiry-step-heading"><span>03 / Investment &amp; timing</span><h3 id="investment-title" tabindex="-1">What feels comfortable?</h3><p>These ranges help us recommend the right scope. Your proposal will reflect your project’s needs.</p></div>
        <fieldset class="choice-group"><legend>What investment range have you set aside? <span class="required">*</span></legend><div class="choice-stack">
          {budgetBands.map((band, index) => <label class="choice-option"><input type="radio" name="budgetBand" value={band.value} required={index === 0} /><span data-budget-label data-usd={band.usd} data-aed={band.aed}>{band.usd}</span></label>)}
          <label class="choice-option"><input type="radio" name="budgetBand" value="guidance" /><span>I’d like your guidance</span></label>
          <label class="choice-option"><input type="radio" name="budgetBand" value="custom" /><span>My own budget</span></label>
        </div><div class="budget-custom-fields" id="budget-custom-fields" hidden>
          <div class="form-field"><label for="custom-budget">YOUR BUDGET / <span data-currency-code>USD</span></label><input id="custom-budget" name="customBudget" type="number" inputmode="numeric" min="1" step="1" placeholder="Your amount" disabled /></div>
          <div class="form-field"><label for="page-count">NUMBER OF PAGES</label><input id="page-count" name="pageCount" type="number" inputmode="numeric" min="1" step="1" placeholder="Your estimate" disabled /></div>
        </div></fieldset>
        <fieldset class="choice-group"><legend>When are you hoping to launch? <span class="required">*</span></legend><div class="choice-stack">
          <label class="choice-option"><input type="radio" name="timeline" value="as-soon-as-possible" required /><span>As soon as possible</span></label>
          <label class="choice-option"><input type="radio" name="timeline" value="within-one-month" /><span>Within 1 month</span></label>
          <label class="choice-option"><input type="radio" name="timeline" value="two-to-three-months" /><span>In 2–3 months</span></label>
          <label class="choice-option"><input type="radio" name="timeline" value="flexible" /><span>I’m flexible</span></label>
        </div></fieldset>
        <div class="step-actions"><button type="button" class="step-back" data-back><Icon name="ArrowLeft" size={18} /> Back</button><button type="button" class="step-next" data-next>Next: your details <Icon name="ArrowUpRight" size={19} /></button></div>
      </section>

      <section class="enquiry-step" data-step="3" aria-labelledby="details-title" hidden>
        <div class="enquiry-step-heading"><span>04 / Tell me about you</span><h3 id="details-title" tabindex="-1">Almost there.</h3><p>Share the story behind the project and the best way to reach you.</p></div>
        <div class="form-field"><label for="full-name">FULL NAME <span class="required">*</span></label><input id="full-name" name="fullName" type="text" autocomplete="name" placeholder="Your full name" required maxlength="120" /></div>
        <div class="form-field"><label for="email">EMAIL ADDRESS <span class="required">*</span></label><input id="email" name="email" type="email" autocomplete="email" placeholder="you@yourbusiness.com" required maxlength="254" /></div>
        <div class="form-field"><label for="business">BUSINESS OR BRAND NAME</label><input id="business" name="business" type="text" autocomplete="organization" placeholder="Your business name" maxlength="180" /></div>
        <div class="form-field"><label for="website">EXISTING WEBSITE <span class="label-hint">If you have one</span></label><input id="website" name="website" type="url" inputmode="url" autocomplete="url" placeholder="https://yourwebsite.com" maxlength="500" /></div>
        <div class="form-field"><label for="project-details">TELL ME ABOUT YOUR PROJECT <span class="required">*</span></label><textarea id="project-details" name="projectDetails" rows="5" placeholder="What does your business do, and what would you like your website to achieve?" required maxlength="4000"></textarea></div>
        <div class="step-actions step-actions-final"><button type="button" class="step-back" data-back><Icon name="ArrowLeft" size={18} /> Back</button><button type="submit" class="step-next">Prepare my enquiry <Icon name="ArrowUpRight" size={19} /></button></div>
        <p class="enquiry-send-note">This opens an email draft with your answers. Send the draft to complete your enquiry.</p>
      </section>
      <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
    </form>
  </section>

  <Faq id="contact-faq-title" title="BEFORE YOU ASK" questions={contactFaqs} />
  <section class="contact-outro" aria-labelledby="contact-outro-title"><p>THE NEXT GOOD THING / STARTS WITH A HELLO</p><h2 id="contact-outro-title">SEE YOU IN<br>MY INBOX<span>.</span></h2><a href="mailto:hello@jenniemuso.com">hello@jenniemuso.com <Icon name="ArrowUpRight" size={22} /></a></section>
  <script src="/contact.js" defer></script>
</Layout>

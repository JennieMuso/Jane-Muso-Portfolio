---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import { contactFaqs } from '../data/faqs';
import { contentUpdated, faqSchema, graph, personSchema, siteUrl } from '../data/seo';
const schema = graph(
  personSchema,
  { '@type': 'ContactPage', '@id': `${siteUrl}/contact/#webpage`, url: `${siteUrl}/contact/`, name: 'Contact Jennie Muso', mainEntity: { '@id': `${siteUrl}/#jennie-muso` }, dateModified: contentUpdated },
  faqSchema(contactFaqs)
);
---
<Layout
  title="Contact — Jennie Muso"
  description="Tell Jennie Muso about your business and the website, app, or digital experience you want to create."
  current="contact"
  styles={['fonts.css', 'styles.css', 'editorial.css', 'projects.css', 'reference-layout.css', 'refinements.css', 'contact.css', 'faq.css']}
  bodyClass="contact-page"
  schema={schema}
  modified={contentUpdated}
>
  <section class="contact-hero" aria-labelledby="contact-page-title">
    <div class="contact-page-meta"><span>Jennie Muso / Founder & Designer</span><span>Open to thoughtful collaborations</span><span>Contact / Start here</span></div>
    <h1 id="contact-page-title">LET’S TALK<span>.</span><br>ABOUT IT<span>.</span></h1>
    <div class="contact-hero-stage">
      <div class="contact-hero-note">
        <p>Good work starts with a good conversation. Tell me what you’re making, what’s getting in the way, and what you want people to feel when they find you.</p>
        <a class="contact-hero-link" href="#project-brief">Tell me about your idea <Icon name="ArrowUpRight" size={20} /></a>
        <span class="contact-hero-caption">A little curiosity makes the best work.</span>
      </div>
      <figure class="contact-portrait">
        <img src="/assets/jennie-portrait-preview.jpg" alt="Jennie Muso working at her desk with a tablet" width="1086" height="1448" fetchpriority="high" />
      </figure>
    </div>
  </section>

  <section class="project-brief" id="project-brief" aria-labelledby="project-brief-title">
    <div class="project-brief-intro">
      <h2 id="project-brief-title">TELL ME<br>WHAT’S ON<br>YOUR MIND<span>.</span></h2>
      <p>Whether your idea is fully formed or still a few notes on a page, I’d love to hear it. The details below help me understand what matters most to you.</p>
      <div class="brief-direct"><span>Prefer to keep it simple?</span><a href="mailto:hello@jenniemuso.com">Email me directly <Icon name="ArrowUpRight" size={18} /></a></div>
    </div>

    <form class="project-form" id="project-form" action="mailto:hello@jenniemuso.com" method="post" enctype="text/plain">
      <div class="form-field">
        <label for="full-name"><span>FULL NAME <span class="required">*</span></span></label>
        <input id="full-name" name="fullName" type="text" autocomplete="name" placeholder="Your name" required maxlength="120" />
      </div>
      <div class="form-field">
        <label for="email"><span>EMAIL ADDRESS <span class="required">*</span></span></label>
        <input id="email" name="email" type="email" autocomplete="email" placeholder="you@yourbusiness.com" required maxlength="254" />
      </div>
      <div class="form-field">
        <label for="business"><span>YOUR BUSINESS <span class="required">*</span></span><span class="label-hint">What do you do?</span></label>
        <textarea id="business" name="business" rows="3" placeholder="Tell me what you’re building and who it’s for." required maxlength="1800"></textarea>
      </div>
      <div class="form-field form-select-field">
        <label for="service"><span>WHAT CAN I HELP WITH? <span class="required">*</span></span></label>
        <div class="select-wrap"><select id="service" name="service" required><option value="" disabled selected>Choose a service</option><option>Website or app design</option><option>UX design</option><option>No-code website build</option><option>Custom website development</option><option>Design and development together</option><option>Something else — let’s talk</option></select><Icon name="CaretDown" size={20} /></div>
      </div>
      <fieldset class="form-field budget-field">
        <legend>PROJECT BUDGET <span class="required">*</span></legend>
        <p class="budget-intro">Choose the closest fit, or share your own budget and page count. These are guides; the final scope is shaped around your project.</p>
        <div class="budget-options">
          <label class="budget-option"><input type="radio" name="budget" value="$1,500 — starter project" required /><span><strong>$1,500</strong><small>Starter project</small></span></label>
          <label class="budget-option"><input type="radio" name="budget" value="$2,500 — 4 pages" /><span><strong>$2,500</strong><small>4 pages</small></span></label>
          <label class="budget-option"><input type="radio" name="budget" value="$5,000 — 5–8 pages" /><span><strong>$5,000</strong><small>5–8 pages</small></span></label>
          <label class="budget-option"><input type="radio" name="budget" value="$8,000 — 10–14 pages" /><span><strong>$8,000</strong><small>10–14 pages</small></span></label>
          <label class="budget-option budget-option-custom"><input type="radio" name="budget" value="custom" /><span><strong>My own budget</strong><small>Tell me what works for you</small></span></label>
        </div>
        <div class="budget-custom-fields" id="budget-custom-fields" hidden>
          <div><label for="custom-budget">YOUR BUDGET / USD</label><div class="budget-input-wrap"><span aria-hidden="true">$</span><input id="custom-budget" name="customBudget" type="number" inputmode="numeric" min="1" step="1" placeholder="Your amount" disabled /></div></div>
          <div><label for="page-count">NUMBER OF PAGES</label><div class="budget-input-wrap"><input id="page-count" name="pageCount" type="number" inputmode="numeric" min="1" step="1" placeholder="Your estimate" disabled /></div></div>
        </div>
      </fieldset>
      <div class="form-field form-select-field">
        <label for="timeline"><span>TIMING</span></label>
        <div class="select-wrap"><select id="timeline" name="timeline"><option value="" selected>When are you hoping to start?</option><option>As soon as possible</option><option>In the next 1–2 months</option><option>In 3–6 months</option><option>I’m flexible</option></select><Icon name="CaretDown" size={20} /></div>
      </div>
      <div class="form-field">
        <label for="project-details"><span>THE BIG PICTURE <span class="required">*</span></span><span class="label-hint">Dream a little</span></label>
        <textarea id="project-details" name="projectDetails" rows="5" placeholder="What would you love this project to make possible? Any links, goals, or questions I should know about?" required maxlength="4000"></textarea>
      </div>
      <div class="form-submit-row"><p>Submitting opens an email draft with your answers. Send the draft to complete your enquiry.</p><button type="submit">Prepare my enquiry <Icon name="ArrowUpRight" size={22} /></button></div>
      <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
    </form>
  </section>

  <Faq id="contact-faq-title" title="BEFORE YOU ASK" questions={contactFaqs} />
  <section class="contact-outro" aria-labelledby="contact-outro-title"><p>THE NEXT GOOD THING / STARTS WITH A HELLO</p><h2 id="contact-outro-title">SEE YOU IN<br>MY INBOX<span>.</span></h2><a href="mailto:hello@jenniemuso.com">hello@jenniemuso.com <Icon name="ArrowUpRight" size={22} /></a></section>
  <script src="/contact.js" defer></script>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import InsightCard from '../components/InsightCard.astro';
import Faq from '../components/Faq.astro';
import type { Article } from '../data/articles';
import type { Project } from '../data/projects';
import { getArticles } from '../lib/blog';
import { getHomePage } from '../lib/home';
import { getProjects } from '../lib/work';
import { projectAsset } from '../data/projects';
import { imageUrl, imageSrcSet } from '../lib/image';
import { contentUpdated, faqSchema, graph, organizationSchema, personSchema, siteUrl } from '../data/seo';
const [articles, projects, home] = await Promise.all([getArticles(), getProjects(), getHomePage()]);
const aboutWords = home.aboutStatement.split(' ');
const miniClasses = ['mini-verya', 'mini-bayline', 'mini-jin', 'mini-nacre'];
const chosenProjects = home.featuredProjectSlugs.map((slug) => projects.find((project) => project.slug === slug)).filter((project): project is Project => Boolean(project));
const featuredProjects = (chosenProjects.length ? chosenProjects : projects).slice(0, 4);
const chosenArticles = home.featuredArticleSlugs.map((slug) => articles.find((article) => article.slug === slug)).filter((article): article is Article => Boolean(article));
const featuredArticles = (chosenArticles.length ? chosenArticles : articles).slice(0, 3);
const schema = graph(
  organizationSchema,
  personSchema,
  { '@type': 'WebSite', '@id': `${siteUrl}/#website`, name: 'Muso.designs', url: siteUrl, publisher: { '@id': `${siteUrl}/#organization` }, dateModified: contentUpdated },
  { '@type': 'WebPage', '@id': `${siteUrl}/#webpage`, url: `${siteUrl}/`, name: 'Website Design & Development — Jane Muso', about: { '@id': `${siteUrl}/#jane-muso` }, dateModified: contentUpdated },
  faqSchema(home.faqs)
);
---
<Layout title='Website Design & Development — Jane Muso' description={home.seoDescription} current='home' styles={['fonts.css','styles.css','editorial.css','projects.css','reference-layout.css','refinements.css','final-touches.css','latest.css','insights.css','preview-fixes.css','iteration.css','content-updates.css','faq.css']} schema={schema} modified={contentUpdated}>

      <section class="hero editorial-hero" id="work" aria-labelledby="hero-title">
        <div class="hero-meta">{home.heroMeta.map((label) => <span>{label}</span>)}</div>
        <h1 id="hero-title">Muso<span>.designs</span></h1>
        <div class="editorial-gallery" aria-label="Featured projects">
          {featuredProjects.map((project, index) => <figure class:list={['project-mini', miniClasses[index]]}><img src={imageUrl(projectAsset(project, 'hero'), 768)} srcset={imageSrcSet(projectAsset(project, 'hero'), [320, 480, 768])} sizes="(max-width: 560px) 50vw, 25vw" alt={project.heroAlt} width="768" height="512" loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'low'} decoding="async" /><figcaption><strong>{project.name}</strong><span>Website design &amp; development</span></figcaption><a class="mini-link" href={`/work/${project.slug}/`} aria-label={`View ${project.name} case study`}><span class="project-view-cue">View work <Icon name="ArrowUpRight" size={17} /></span></a></figure>)}
          <p class="gallery-thesis">{home.galleryThesis.split('\n').map((line, index) => <>{index > 0 && <br />}{line}</>)}</p>
          <a class="gallery-link" href="/work/">View more work <Icon name="ArrowUpRight" size={20} /></a>
        </div>
        <div class="hero-foot"><span>{home.workflowTools}</span></div>
      </section>

      <section class="solutions" id="solutions" aria-labelledby="solutions-title">
        <div class="solutions-intro"><h2 id="solutions-title">{home.servicesHeading.split('\n').map((line, index) => <>{index > 0 && <br />}{line}</>)}<span>.</span></h2><p>{home.servicesIntro}</p></div>
        <div class="solutions-list">
          {home.services.map((service, index) => <details class="solution" open={index === 0}><summary><span>{service.title}</span><img src={imageUrl(service.image, 640)} srcset={imageSrcSet(service.image, [320, 480, 640])} sizes="(max-width: 560px) 96px, (max-width: 800px) 180px, 40vw" alt="" width="630" height="624" loading="lazy" decoding="async" /></summary><div class="solution-content"><div class="solution-copy">{service.paragraphs.map((paragraph) => <p>{paragraph}</p>)}<span>{service.audience}</span></div></div></details>)}
        </div>
        <a class="text-link services-home-link" href="/services/">Explore website packages <Icon name="ArrowUpRight" size={20} /></a>
      </section>

      <section class="manifesto about-story" id="about" aria-labelledby="about-title">
        <div class="about-top"><span class="about-photo"><img src={imageUrl(home.aboutPortrait, 480)} srcset={imageSrcSet(home.aboutPortrait, [160, 320, 480])} sizes="(max-width: 560px) 90px, 180px" alt={home.aboutPortraitAlt} width="1086" height="1448" loading="lazy" decoding="async" /></span><span class="about-name">{home.aboutName}<br />{home.aboutRole}</span></div>
        <h2 id="about-title" class="about-statement" aria-label={home.aboutStatement}>{aboutWords.map((word, index) => <><span class:list={['reveal-word', { revealed: index < 4 }]}>{word}</span>{index < aboutWords.length - 1 ? ' ' : ''}</>)}</h2>
        <a class="text-link about-link" href={home.aboutLinkUrl} target="_blank" rel="noopener noreferrer">{home.aboutLinkLabel} <Icon name="ArrowUpRight" size={20} /></a>
      </section>

      <section class="insights" id="insights" aria-labelledby="insights-title"><div class="insights-head"><h2 id="insights-title">{home.insightsHeading.split('\n').map((line, index) => <>{index > 0 && <br />}{line}</>)}<span>.</span></h2><p>{home.insightsIntro}</p></div><div class="insights-grid">
        {featuredArticles.map((article, index) => <InsightCard article={article} featured={index === 0} />)}
      </div><a class="text-link insights-more" href="/blog/">View more insights <Icon name="ArrowUpRight" size={20} /></a></section>

      <section class="shop-teaser" id="shop" aria-labelledby="shop-title"><h2 id="shop-title">{home.shopHeading.split('\n').map((line, index) => <>{index > 0 && <br />}{line}</>)}<span>.</span></h2><div class="shop-bottom"><p>{home.shopIntro}</p><a class="text-link shop-link" href="/shop/">Explore the shop <Icon name="ArrowUpRight" size={20} /></a></div></section>
      <Faq id="home-faq-title" title={home.faqHeading} intro={home.faqIntro} questions={home.faqs} />
      <section class="contact" id="contact" aria-labelledby="contact-title"><div class="contact-main"><div class="contact-copy"><p>{home.contactKicker}</p><h2 id="contact-title">{home.contactHeading.split('\n').map((line, index) => <>{index > 0 && <br />}{line}</>)}<span>.</span></h2></div><div class="contact-eyes" aria-hidden="true"><span class="contact-eye"><span class="contact-pupil"></span></span><span class="contact-eye"><span class="contact-pupil"></span></span></div></div><a href="/contact/" class="contact-link">{home.contactLinkLabel} <Icon name="ArrowUpRight" size={20} /></a></section>

</Layout>

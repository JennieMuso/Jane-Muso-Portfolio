---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import { getServicePage } from '../lib/services';
import { faqSchema } from '../data/seo';

const servicePage = await getServicePage();
const { packages: servicePackages, addOns: serviceAddOns } = servicePage;
import { graph, organizationSchema, personSchema, siteUrl } from '../data/seo';

const schema = graph(
  organizationSchema,
  personSchema,
  {
    '@type': 'CollectionPage',
    name: 'Website design and development packages by Muso Design Studio',
    url: `${siteUrl}/services/`,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: servicePackages.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.name,
        url: `${siteUrl}/services/#${item.id}`
      }))
    }
  },
  faqSchema(servicePage.faqs)
);
---
<Layout
  title="Website Design Packages & Services — Jane Muso"
  description={servicePage.seoDescription}
  current="services"
  styles={['fonts.css', 'styles.css', 'services.css', 'faq.css']}
  bodyClass="services-page"
  schema={schema}
>
  <section class="services-hero" aria-labelledby="services-title">
    <div class="services-eyebrow"><span>Muso Design Studio / Services</span><span>Website design &amp; development</span></div>
    <h1 id="services-title">{servicePage.heroTitle.split('\n').map((line, index) => <>{index > 0 && <br />}{line}</>)}</h1>
    <div class="services-hero-bottom">
      <p>{servicePage.heroIntro}</p>
      <a href="#packages">Explore the packages <Icon name="ArrowDown" size={20} /></a>
    </div>
  </section>

  <nav class="services-index" id="packages" aria-label="Website packages">
    <span>Find your fit</span>
    {servicePackages.map((item) => <a href={`#${item.id}`}><span>{item.number}</span>{item.name}<Icon name="ArrowDown" size={18} /></a>)}
  </nav>

  {servicePackages.map((item, index) => <section class:list={['service-tier', { 'service-tier-dark': index === 2 }]} id={item.id} aria-labelledby={`${item.id}-title`}>
    <div class="tier-heading">
      <div><span class="tier-kicker">{item.number} / Website package</span><h2 id={`${item.id}-title`}>{item.name}<span>.</span></h2><p>{item.tagline}</p></div>
      <div class="tier-price"><span>Starting at</span><strong>USD {item.priceUsd}</strong><small>UAE guide: AED {item.priceAed}</small></div>
    </div>
    <div class="tier-content">
      <figure class="tier-image"><img src={item.image} alt={item.imageAlt} width="630" height="630" loading="lazy" decoding="async" /><figcaption>{item.name} / A website shaped for your next step</figcaption></figure>
      <div class="tier-details">
        <div class="tier-facts"><div><span>Typical delivery</span><strong>{item.duration}</strong></div><div><span>Unique pages</span><strong>{item.pages}</strong></div></div>
        <div class="tier-audience"><h3>Who it’s for</h3><p>{item.audience}</p></div>
        <div class="tier-includes"><h3>What you receive</h3><ul>{item.deliverables.map((deliverable) => <li>{deliverable}</li>)}</ul></div>
        <a class="tier-action" href={`/contact/?package=${encodeURIComponent(item.id)}#project-brief`}>Discuss {item.name} <Icon name="ArrowUpRight" size={22} /></a>
      </div>
    </div>
    <div class="tier-benefit"><span>The business benefit</span><p>{item.benefit}</p></div>
  </section>)}

  <section class="services-process" aria-labelledby="process-title">
    <div><span class="section-kicker">The way we work</span><h2 id="process-title">{servicePage.processTitle.split('\n').map((line, index) => <>{index > 0 && <br />}{line}</>)}<span>.</span></h2></div>
    <div class="process-copy">{servicePage.processParagraphs.map((paragraph) => <p>{paragraph}</p>)}</div>
  </section>

  <section class="services-addons" id="add-ons" aria-labelledby="addons-title">
    <div class="addons-header"><span class="section-kicker">Optional add-ons &amp; ongoing care</span><h2 id="addons-title">MAKE IT<br />YOUR OWN<span>.</span></h2><p>{servicePage.addOnsIntro}</p></div>
    <div class="addons-list" aria-label="Optional add-on prices">{serviceAddOns.map((addon) => <div class="addon-row"><div><h3>{addon.name}</h3>{addon.note && <p>{addon.note}</p>}</div><div class="addon-price"><strong>{addon.priceUsd || addon.price}</strong>{addon.priceUsd && addon.priceUsd !== addon.price && <small>{addon.price}</small>}</div></div>)}</div>
    <div class="care-intro"><span class="section-kicker">Stay in good shape</span><h3>Care after launch<span>.</span></h3></div>
    <div class="care-options">{servicePage.careOptions.map((care, index) => <div><span>{String(index + 1).padStart(2, '0')} / {care.name}</span><strong>{(care.priceUsd || care.price).replace(/\s*\/\s*month$/i, '')}{/\/\s*month$/i.test(care.priceUsd || care.price) && <em> / month</em>}</strong>{care.priceUsd && <small>{care.price}</small>}<p>{care.description}</p></div>)}</div>
    <div class="services-terms"><p>{servicePage.terms}</p><details><summary>What is outside the package scope?</summary><p>{servicePage.scopeExclusions}</p></details></div>
    <div class="services-end"><span>Have something in mind?</span><a href="/contact/#project-brief">LET’S MAKE<br />IT HAPPEN<Icon name="ArrowUpRight" size={42} /></a></div>
  </section>
  <Faq id="services-faq-title" title={servicePage.faqHeading} intro={servicePage.faqIntro} questions={servicePage.faqs} />
</Layout>

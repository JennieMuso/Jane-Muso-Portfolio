---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { projectAsset } from '../data/projects';
import { imageUrl, imageSrcSet } from '../lib/image';
import { getProjects, getWorkPage } from '../lib/work';
import { graph, organizationSchema, siteUrl } from '../data/seo';

const [projects, workPage] = await Promise.all([getProjects(), getWorkPage()]);
const positions = ['a', 'b', 'c', 'd'];
const schema = graph(organizationSchema, { '@type': 'CollectionPage', name: 'Selected work by Jane Muso', url: `${siteUrl}/work/`, mainEntity: { '@type': 'ItemList', itemListElement: projects.map((project, index) => ({ '@type': 'ListItem', position: index + 1, name: project.name, url: `${siteUrl}/work/${project.slug}/` })) } });
---
<Layout title="Website Design Portfolio & Case Studies — Jane Muso" description={workPage.seoDescription || workPage.intro} current="work" styles={['fonts.css','styles.css','editorial.css','projects.css','reference-layout.css','refinements.css','work-intro.css']} bodyClass="work-page" schema={schema}>
  <div class="page-intro"><h1>{workPage.title}</h1><p>{workPage.intro}</p></div>
  <section class="work" id="work" aria-label="Selected websites">
    <div class="section-head"><h2>Selected work</h2></div>
    <div class="work-grid">
      {projects.map((project, index) => <article class:list={['work-item', `work-item-${positions[index % positions.length]}`]}>
        <div class="work-media"><img src={imageUrl(projectAsset(project, 'hero'), 1400)} srcset={imageSrcSet(projectAsset(project, 'hero'), [480, 800, 1100, 1400])} sizes="(max-width: 560px) 100vw, 55vw" alt={project.heroAlt} loading="lazy" decoding="async" style={`view-transition-name: project-${project.slug}`} /></div>
        <div class="work-caption"><h3>{project.name}</h3><span>Website design &amp; development</span></div>
        <a class="work-card-link" href={`/work/${project.slug}/`} aria-label={`View ${project.name} case study`}></a>
      </article>)}
    </div>
    <div class="work-end"><p class="work-note">{workPage.endNote}</p><a class="text-link" href="/contact/">Discuss a project <Icon name="ArrowUpRight" size={20} /></a></div>
  </section>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import InsightCard from '../components/InsightCard.astro';
import { articles } from '../data/articles';
---
<Layout title="Insights — Jennie Muso" description="Writing by Jennie Muso on website strategy, design, trust and building for real people." current="blog" styles={['fonts.css','styles.css','editorial.css','projects.css','reference-layout.css','refinements.css','final-touches.css','insights.css','iteration.css','content-updates.css']} bodyClass="insights-index">
  <section class="blog-intro" aria-labelledby="blog-title"><p>Notes from the studio / {String(articles.length).padStart(2, '0')} stories</p><h1 id="blog-title">INSIGHTS<span>.</span></h1><p>Ideas about design, clarity, and building for real people.</p></section>
  <section class="insights blog-list" aria-label="Articles"><div class="insights-grid">{articles.map((article) => <InsightCard article={article} />)}</div></section>
</Layout>

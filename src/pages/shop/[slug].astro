---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import ProductVisual from '../../components/ProductVisual.astro';
import { products, type Product } from '../../data/products';

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props as { product: Product };
const index = products.findIndex((item) => item.slug === product.slug);
const next = products[(index + 1) % products.length];
---
<Layout title={`${product.name} — Shop by Jane Muso`} description={product.summary} current="shop" styles={['fonts.css', 'styles.css', 'shop-catalog.css']} bodyClass="shop-detail-page" image={product.coverImage}>
  <article>
    <header class="product-heading">
      <div class="product-topline"><a href="/shop/"><Icon name="ArrowLeft" size={16} /> The shop</a><span>{product.category === 'component' ? 'Framer component' : 'Framer website template'} / {product.price}</span></div>
      <h1>{product.name}<span>.</span></h1>
      <div class="product-title-foot"><span>Made by Jane Muso</span><span>Digital goods / Framer</span></div>
    </header>
    <div class="product-hero-art"><ProductVisual product={product} /></div>
    <section class="product-intro" aria-labelledby="product-intro-title">
      <div class="product-facts"><h2 id="product-intro-title">{product.category === 'component' ? 'The component' : 'The template'}</h2><dl><div><dt>Format</dt><dd>Framer {product.category === 'component' ? 'component' : 'website template'}</dd></div><div><dt>Price</dt><dd>{product.price}</dd></div><div><dt>Preview</dt><dd>Live website</dd></div></dl></div>
      <div class="product-story"><p class="product-lede">{product.summary}</p>{product.description.map((paragraph) => <p>{paragraph}</p>)}<div class="product-actions"><a class="product-button product-button-outline" href="#live-preview">Show preview <Icon name="ArrowDown" size={18} /></a><a class="product-button product-button-primary" href={product.checkoutUrl} target="_blank" rel="noopener noreferrer">Buy now — {product.price} <Icon name="ArrowUpRight" size={20} /></a></div><a class="product-source-link" href={product.framerUrl} target="_blank" rel="noopener noreferrer">View on Framer <Icon name="ArrowUpRight" size={16} /></a></div>
    </section>
    <section class="product-preview-section" id="live-preview" aria-labelledby="preview-title"><div class="product-preview-header"><div><span>Try before you buy</span><h2 id="preview-title">SEE IT<br />IN ACTION<span>.</span></h2></div><p>Explore the live {product.category === 'component' ? 'component' : 'template'} below. Open the full preview for the complete experience.</p></div>
      <div class="preview-toolbar"><div class="preview-toolbar-left"><span class="browser-dots"><i></i><i></i><i></i></span><span class="preview-address">{new URL(product.previewUrl).hostname}</span></div><div class="preview-toolbar-right"><div class="preview-device-switch" role="group" aria-label="Preview width"><button type="button" class="active" data-width="desktop" aria-pressed="true">Desktop</button><button type="button" data-width="mobile" aria-pressed="false">Mobile</button></div><a href={product.previewUrl} target="_blank" rel="noopener noreferrer" aria-label={`Open ${product.name} full preview`}><Icon name="ArrowUpRight" size={19} /></a></div></div>
      <div class="preview-stage"><div class="preview-window"><iframe data-src={product.previewUrl} title={`${product.name} live preview`} loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe><div class="preview-poster"><ProductVisual product={product} /><div class="preview-poster-actions"><button type="button" data-load-preview>Load live preview <Icon name="ArrowUpRight" size={19} /></button><a href={product.previewUrl} target="_blank" rel="noopener noreferrer">Open in new tab <Icon name="ArrowUpRight" size={19} /></a></div></div></div><div class="preview-help">If the embedded preview does not load, <a href={product.previewUrl} target="_blank" rel="noopener noreferrer">open the full preview <Icon name="ArrowUpRight" size={15} /></a>.</div></div>
      <div class="preview-foot"><span>Live preview / Framer</span><a href={product.previewUrl} target="_blank" rel="noopener noreferrer">Open full preview <Icon name="ArrowUpRight" size={18} /></a></div>
    </section>
    <section class="product-includes"><div><span>In the collection</span><h2>MADE TO<br />MAKE MORE<span>.</span></h2></div><ul>{product.features.map((feature) => <li>{feature}<Icon name="ArrowUpRight" size={20} /></li>)}</ul></section>
    <section class="product-purchase"><p>Ready to make it yours?</p><h2>{product.name}<span>.</span></h2><a href={product.checkoutUrl} target="_blank" rel="noopener noreferrer">Buy now — {product.price} <Icon name="ArrowUpRight" size={24} /></a><small>Secure checkout on Lemon Squeezy.</small></section>
    <a class="product-next" href={`/shop/${next.slug}/`}><span>Explore another</span><strong>{next.name}<Icon name="ArrowUpRight" size={30} /></strong></a>
  </article>
  <script src="/shop-preview.js" defer></script>
</Layout>

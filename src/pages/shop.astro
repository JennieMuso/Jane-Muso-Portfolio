---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import Icon from '../components/Icon.astro';
import { products } from '../data/products';
const components = products.filter((product) => product.category === 'component').length;
const templates = products.filter((product) => product.category === 'template').length;
---
<Layout title="Shop — Jennie Muso" description="Framer components and website templates by Jane Muso. Explore live previews before you buy." current="shop" styles={['fonts.css', 'styles.css', 'shop-catalog.css']} bodyClass="shop-catalog-page">
  <section class="shop-heading" aria-labelledby="shop-title">
    <div class="shop-heading-top"><span>Made by Jane Muso</span><span>Components &amp; website templates</span></div>
    <h1 id="shop-title">THE SHOP<span>.</span></h1>
    <div class="shop-heading-bottom"><p>Small pieces with big ideas. Explore the live preview, find your fit, and make something of your own.</p><a href="#shop-products">Explore the collection <Icon name="ArrowDown" size={18} /></a></div>
  </section>
  <section class="shop-collection" id="shop-products" aria-label="Products">
    <div class="shop-collection-head"><h2>THE COLLECTION<span>.</span></h2><p>Design tools for the things you want to build next.</p></div>
    <div class="shop-tabs" role="group" aria-label="Filter products">
      <button type="button" class="active" data-filter="all" aria-pressed="true">All <span>{String(products.length).padStart(2, '0')}</span></button>
      <button type="button" data-filter="component" aria-pressed="false">Components <span>{String(components).padStart(2, '0')}</span></button>
      <button type="button" data-filter="template" aria-pressed="false">Website templates <span>{String(templates).padStart(2, '0')}</span></button>
    </div>
    <p class="shop-results" aria-live="polite">Showing all {products.length} products</p>
    <div class="shop-grid">{products.map((product) => <ProductCard product={product} />)}</div>
  </section>
  <section class="shop-endnote"><p>Want to see the ideas in motion?</p><a href="https://www.framer.com/@jane-muthoni-muchiri/" target="_blank" rel="noopener noreferrer">Explore Jane’s Framer profile <Icon name="ArrowUpRight" size={23} /></a></section>
  <script src="/shop-filter.js" defer></script>
</Layout>

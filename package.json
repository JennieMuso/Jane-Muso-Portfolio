{
  "name": "muso-designs",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 0.0.0.0",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 0.0.0.0",
    "deploy": "npm run build && wrangler pages deploy dist --project-name musodesigns"
  },
  "dependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "astro": "^7.4.12"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
